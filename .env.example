# MAL API
MAL_API_BASE_URL=https://api.myanimelist.net/v2
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Caps concurrent upstream MAL requests to avoid bursts and rate-limit errors.
MAL_MAX_CONCURRENT_REQUESTS=8

# NEWS API
ANIME_NEWS_API_BASE_URL=https://aninews.vercel.app

# SITE METADATA
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# RESILIENCE
# Per-instance API concurrency before returning 503. Tune lower on small instances.
NOXY_API_MAX_CONCURRENT_REQUESTS=80
# Multiplies per-IP API rate limits. Use >1 when limits are enforced upstream by a shared gateway.
NOXY_API_RATE_LIMIT_MULTIPLIER=1
# Fraction of max active requests where optional endpoints begin returning 503.
NOXY_NON_CRITICAL_LOAD_SHED_THRESHOLD=0.75
# Returns 503 for optional discovery/news endpoints during incidents or high load.
NOXY_DISABLE_NON_CRITICAL_FEATURES=false

# SUPABASE
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
