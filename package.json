{
  "name": "noxy",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "format": "oxfmt . --write --ignore-path .oxfmtignore",
    "format:check": "oxfmt . --check --ignore-path .oxfmtignore",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "DEBUG= vitest",
    "test:components": "DEBUG= vitest run --project nuxt",
    "test:composables": "DEBUG= vitest run --project unit",
    "test:coverage": "DEBUG= vitest run --coverage",
    "test:ci": "DEBUG= vitest run --coverage",
    "test:nuxt": "DEBUG= vitest run --project nuxt",
    "test:run": "DEBUG= vitest run",
    "test:ui": "DEBUG= vitest --ui",
    "test:unit": "DEBUG= vitest run --project unit",
    "test:watch": "DEBUG= vitest --watch",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/image": "^2.0.0",
    "@pinia/nuxt": "0.11.3",
    "@supabase/supabase-js": "^2.110.7",
    "@unocss/reset": "^66.6.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.4.2",
    "swiper": "^12.1.3",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@iconify-json/ci": "^1.2.2",
    "@iconify-json/eos-icons": "^1.2.4",
